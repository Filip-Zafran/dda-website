# Anthropic API Key - Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Server port (optional, defaults to 3000)
PORT=3000

# Long random secret used to pseudonymize visitor IP addresses.
# Generate one for production, for example: openssl rand -hex 32
VISITOR_HASH_SALT=replace-with-a-long-random-secret

# Number of reverse proxies in front of Express (usually 1 on hosted platforms)
TRUST_PROXY_HOPS=1
